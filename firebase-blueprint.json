{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile and account settings",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 256 },
        "name": { "type": "string", "maxLength": 128 },
        "phone": { "type": "string", "maxLength": 32 },
        "role": { "type": "string", "enum": ["buyer", "seller", "investor", "agent", "guest", "admin"] },
        "photoURL": { "type": "string", "maxLength": 1024 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "name", "role", "createdAt", "updatedAt"]
    },
    "SavedProperty": {
      "title": "SavedProperty",
      "description": "Bookmarked property by user",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "propertyId": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 256 },
        "price": { "type": "number" },
        "city": { "type": "string", "maxLength": 64 },
        "type": { "type": "string", "maxLength": 64 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "propertyId", "title", "createdAt"]
    },
    "ChatSession": {
      "title": "ChatSession",
      "description": "User conversational session record",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 256 },
        "mode": { "type": "string", "enum": ["smart", "fast", "thinking", "search", "maps", "science"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "title", "mode", "createdAt", "updatedAt"]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "Individual message in a chat session",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "sessionId": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "role": { "type": "string", "enum": ["user", "model", "system"] },
        "content": { "type": "string", "maxLength": 20000 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "sessionId", "userId", "role", "content", "createdAt"]
    },
    "PropertyInquiry": {
      "title": "PropertyInquiry",
      "description": "Property consultation or booking inquiry lead",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "propertyId": { "type": "string", "maxLength": 128 },
        "propertyTitle": { "type": "string", "maxLength": 256 },
        "userName": { "type": "string", "maxLength": 128 },
        "userPhone": { "type": "string", "maxLength": 32 },
        "userEmail": { "type": "string", "maxLength": 256 },
        "message": { "type": "string", "maxLength": 2000 },
        "status": { "type": "string", "enum": ["pending", "contacted", "closed"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "propertyId", "propertyTitle", "userName", "status", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profiles partitioned by auth UID"
    },
    "/saved_properties/{savedPropertyId}": {
      "schema": "SavedProperty",
      "description": "Saved listings owned by users"
    },
    "/chat_sessions/{sessionId}": {
      "schema": "ChatSession",
      "description": "Chat sessions stored per user"
    },
    "/chat_sessions/{sessionId}/messages/{messageId}": {
      "schema": "ChatMessage",
      "description": "Subcollection of chat messages in a session"
    },
    "/inquiries/{inquiryId}": {
      "schema": "PropertyInquiry",
      "description": "Property leads and consultation inquiries"
    }
  }
}
